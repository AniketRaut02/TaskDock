{
  "manifest_version": 3,
  "name": "TaskDock downloads",
  "version": "0.1.0",
  "description": "Shows this browser's downloads on the TaskDock desktop widget. Sends file names, sizes and states to 127.0.0.1 only; never URLs.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html"
}
