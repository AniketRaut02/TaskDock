<Project Sdk="Microsoft.NET.Sdk">
  <!-- Classic in-process VSSDK extension: loads in Visual Studio 2022 (17.x) and 2026 (18.x).
       Build with Visual Studio's MSBuild (tools/release.ps1 finds it with vswhere). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TaskDock.VisualStudio</RootNamespace>
    <AssemblyName>TaskDock.VisualStudio</AssemblyName>
    <Version>0.1.0</Version>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.12.1606" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <Content Include="LICENSE.txt" IncludeInVSIX="true" />
    <Content Include="TaskDock.png" IncludeInVSIX="true" />
  </ItemGroup>
</Project>
