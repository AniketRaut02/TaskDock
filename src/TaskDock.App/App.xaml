<Application x:Class="TaskDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskDock.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:VisConverter x:Key="InvVis" Kind="Inverse"/>
            <local:VisConverter x:Key="NotNull" Kind="NotNull"/>
            <local:VisConverter x:Key="NotZero" Kind="NotZero"/>
            <local:VisConverter x:Key="EmptyVis" Kind="Empty"/>
            <local:VisConverter x:Key="NullVis" Kind="Null"/>
            <local:VisConverter x:Key="PinColor" Kind="PinColor"/>
            <local:VisConverter x:Key="ChipBg" Kind="ChipBg"/>
            <local:VisConverter x:Key="IconRes" Kind="Icon"/>

            <!-- How every icon is drawn: a 24x24 path as a round 2 px stroke (the phone draws the same). Wrap it in a
                 24x24 Grid inside a Viewbox to size it. -->
            <Style x:Key="Stroke" TargetType="Path">
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
