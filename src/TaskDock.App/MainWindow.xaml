<Window x:Class="TaskDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskDock.App"
        Title="TaskDock" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" Background="#1E1F24" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#ECEDEE"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <SolidColorBrush x:Key="Muted" Color="#9EA1AA"/>
        <SolidColorBrush x:Key="TileBg" Color="#26282E"/>

        <!-- Typing needs focus: drop NOACTIVATE while a text box is in use. -->
        <Style TargetType="TextBox">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextInput_MouseDown"/>
            <EventSetter Event="LostKeyboardFocus" Handler="TextInput_LostFocus"/>
            <Setter Property="Background" Value="#1A1B1F"/>
            <Setter Property="Foreground" Value="#ECEDEE"/>
            <Setter Property="BorderBrush" Value="#3A3C44"/>
            <Setter Property="CaretBrush" Value="#ECEDEE"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="#ECEDEE"/>
            <Setter Property="Background" Value="#33353C"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#9EA1AA"/>
            <!-- Glyph buttons have no readable text: use the tooltip as the accessible name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="Bell" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Notify"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <TextBlock x:Name="t" Text="&#xE7ED;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#5C5F69" Padding="4,1" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="t" Property="Text" Value="&#xEA8F;"/>
                                <Setter TargetName="t" Property="Foreground" Value="#F5A524"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:TileViewModel}">
            <Border Margin="0,0,0,6" CornerRadius="8" Background="{StaticResource TileBg}" MouseEnter="Tile_MouseEnter" MouseLeftButtonUp="Tile_MouseEnter">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename…" Click="Tile_Rename" IsEnabled="{Binding IsPinned}"/>
                        <MenuItem Header="Focus" Command="{Binding FocusCommand}" IsEnabled="{Binding CanFocus}"/>
                        <MenuItem Header="Launch" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}"/>
                        <MenuItem Header="Remove" Command="{Binding UnpinCommand}" IsEnabled="{Binding IsPinned}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="{Binding ClassBrush}" CornerRadius="8,0,0,8"/>
                    <StackPanel Grid.Column="1" Margin="10,7,8,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Icon}" Content="&#xE8A7;" ToolTip="Focus window" Command="{Binding FocusCommand}"
                                        Visibility="{Binding CanFocus, Converter={StaticResource Vis}}"/>
                                <ToggleButton Style="{StaticResource Bell}" IsChecked="{Binding Notify}" Visibility="{Binding IsPinned, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource Icon}" Content="&#xE718;" ToolTip="Pin" Command="{Binding PinCommand}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource InvVis}}"/>
                                <Button Style="{StaticResource Icon}" Content="&#xE711;" ToolTip="Remove" Command="{Binding UnpinCommand}"
                                        Visibility="{Binding IsPinned, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" Foreground="{Binding ClassBrush}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Visibility="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Vis}}" ToolTip="{Binding Detail}"/>
                            <ProgressBar Height="3" Margin="0,5,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" Foreground="{Binding ClassBrush}"
                                         Background="#33353C" BorderThickness="0" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <Button Style="{StaticResource Btn}" Content="Launch" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding LaunchCommand}"
                                Visibility="{Binding CanLaunch, Converter={StaticResource Vis}}"/>
                        <!-- Downloads: expandable file list -->
                        <Button Style="{StaticResource Btn}" Content="{Binding ItemsToggleText}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="7,1"
                                Command="{Binding ToggleItemsCommand}" Visibility="{Binding ItemsToggleText, Converter={StaticResource NotNull}}"/>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0" Visibility="{Binding ShowItems, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DownloadItemViewModel}">
                                    <StackPanel Margin="0,4,0,2">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource Icon}" Content="&#xE769;" ToolTip="Pause" Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource Vis}}"/>
                                                <Button Style="{StaticResource Icon}" Content="&#xE768;" ToolTip="Resume" Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource Vis}}"/>
                                                <Button Style="{StaticResource Icon}" Content="&#xE711;" ToolTip="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}"/>
                                                <Button Style="{StaticResource Icon}" Content="&#xE8E5;" ToolTip="Open" Command="{Binding OpenCommand}" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}"/>
                                                <Button Style="{StaticResource Icon}" Content="&#xE838;" ToolTip="Show in folder" Command="{Binding ShowCommand}" Visibility="{Binding CanOpen, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding File}">
                                                <Run Text="{Binding File, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Height="2" Margin="0,3,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="#3E8EF7"
                                                     Background="#33353C" BorderThickness="0" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Btn}" Content="▶ Play" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding PlayCommand}"
                                Visibility="{Binding CanPlay, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding CanStopPause, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource Btn}" Content="■ Stop" Command="{Binding StopCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding PauseText}" Command="{Binding PauseCommand}"/>
                        </StackPanel>

                        <!-- Approval card: one per pending request, queued per tile. -->
                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="6" Background="#2F2A1F" BorderBrush="#5A4A22" BorderThickness="1"
                                DataContext="{Binding Approval}" Visibility="{Binding DataContext.Approval, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource NotNull}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE70D;" ToolTip="Show full input" Command="{Binding ToggleExpandedCommand}"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F5A524"/>
                                </DockPanel>
                                <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         TextWrapping="Wrap" MaxHeight="48" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding Expanded, Converter={StaticResource InvVis}}"/>
                                <TextBox Text="{Binding FullInput, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         TextWrapping="Wrap" MaxHeight="220" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding Expanded, Converter={StaticResource Vis}}"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource Btn}" Content="Allow" Background="#2B6E4C" Command="{Binding AllowCommand}"/>
                                    <Button Style="{StaticResource Btn}" Content="Always allow" Command="{Binding AlwaysAllowCommand}"
                                            Visibility="{Binding CanAlwaysAllow, Converter={StaticResource Vis}}"/>
                                    <Button Style="{StaticResource Btn}" Content="Deny" Background="#7A2E31" Command="{Binding DenyCommand}"/>
                                    <Button Style="{StaticResource Btn}" Content="Terminal" ToolTip="Let the terminal prompt decide" Command="{Binding TerminalCommand}"/>
                                </WrapPanel>
                                <Grid Margin="0,6,0,0">
                                    <TextBox Text="{Binding DenyReason, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Deny reason (optional)" Foreground="#5C5F69" Margin="6,2,0,0" IsHitTestVisible="False"
                                               Visibility="{Binding DenyReason, Converter={StaticResource EmptyVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding MoreApprovals}" Foreground="#F5A524" Margin="0,4,0,0" FontSize="11"
                                   Visibility="{Binding MoreApprovals, Converter={StaticResource NotNull}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#33353C" BorderThickness="1" CornerRadius="0">
        <Grid>
            <!-- Pill -->
            <Border Visibility="{Binding IsPill, Converter={StaticResource Vis}}" Padding="12,8" Background="Transparent"
                    MouseLeftButtonDown="Header_MouseDown" ToolTip="Click to expand">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding PillBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PillText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Expanded / compact -->
            <StackPanel Width="320" Visibility="{Binding IsPill, Converter={StaticResource InvVis}}" Margin="8">
                <DockPanel Margin="2,0,0,6" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE8A9;" ToolTip="Cycle mode (Ctrl+Alt+Shift+D)" Command="{Binding CycleModeCommand}"/>
                    <Border DockPanel.Dock="Right" Background="Transparent" Padding="5,0" Margin="2,0,0,0" Cursor="Cross"
                            ToolTip="Drag onto any window to watch it (or drop a shortcut / .exe here)"
                            PreviewMouseLeftButtonDown="Picker_Down" MouseMove="Picker_Move" PreviewMouseLeftButtonUp="Picker_Up">
                        <TextBlock Text="⌖" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="#9EA1AA" VerticalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="7,1" Command="{Binding ToggleDetectedCommand}"
                            ToolTip="Detected sources" Visibility="{Binding DetectedCount, Converter={StaticResource NotZero}}">
                        <TextBlock><Run Text="+"/><Run Text="{Binding DetectedCount, Mode=OneWay}"/><Run Text=" detected"/></TextBlock>
                    </Button>
                    <TextBlock Text="TaskDock" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Detected}" Visibility="{Binding ShowDetected, Converter={StaticResource Vis}}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TileViewModel}">
                            <DockPanel Margin="4,2">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Pin" Command="{Binding PinCommand}"/>
                                <Ellipse Width="8" Height="8" Fill="{Binding ClassBrush}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}"/>

                <!-- Media bar: whatever Windows' media controls say is playing. -->
                <Border Margin="0,2,0,0" Padding="8,7" CornerRadius="8" Background="{StaticResource TileBg}" DataContext="{Binding Media}"
                        Visibility="{Binding HasSession, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Icon}" Content="&#xE892;" ToolTip="Previous" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" FontSize="13"/>
                                <Button Style="{StaticResource Icon}" Content="{Binding PlayGlyph}" ToolTip="Play / pause" Command="{Binding TogglePlayCommand}" IsEnabled="{Binding CanToggle}" FontSize="15" Foreground="#ECEDEE"/>
                                <Button Style="{StaticResource Icon}" Content="&#xE893;" ToolTip="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" FontSize="13"/>
                                <Button Style="{StaticResource Icon}" Content="&#xE70E;" ToolTip="Fold / unfold" Command="{Binding ToggleCollapsedCommand}"/>
                            </StackPanel>
                            <Border Width="34" Height="34" CornerRadius="4" Margin="0,0,8,0" ClipToBounds="True" Visibility="{Binding Thumb, Converter={StaticResource NotNull}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Visibility="{Binding Artist, Converter={StaticResource NotNull}}"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Height="2" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" Foreground="#8B8D98"
                                     Background="#33353C" BorderThickness="0" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}"/>
                        <StackPanel Visibility="{Binding Collapsed, Converter={StaticResource InvVis}}">
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding ShowChips, Converter={StaticResource Vis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE718;" Command="{Binding TogglePinCommand}"
                                        ToolTip="Stick to this app" Foreground="{Binding IsPinned, Converter={StaticResource PinColor}}"/>
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn}" Padding="7,1" Margin="0,0,4,0" Content="{Binding Name}"
                                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding AppId}"
                                                    Background="{Binding Selected, Converter={StaticResource ChipBg}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="YouTube" Margin="4,0,0,0" Command="{Binding SearchYouTubeCommand}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Spotify" Margin="4,0,0,0" Command="{Binding SearchSpotifyCommand}"/>
                                <Grid>
                                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="MediaSearch_KeyDown"/>
                                    <TextBlock Text="Search music…" Foreground="#5C5F69" Margin="6,2,0,0" IsHitTestVisible="False"
                                               Visibility="{Binding Query, Converter={StaticResource EmptyVis}}"/>
                                </Grid>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,2,4,4"
                           Text="Nothing pinned yet. Sources show up under “detected” when they connect. Drag ⌖ onto any window, or drop a shortcut here, to watch it. For Claude Code: tray icon → Connect Claude Code."/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
