<Window x:Class="TaskDock.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskDock settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True" FontSize="13">
    <StackPanel Margin="18" Width="420">
        <StackPanel.Resources>
            <Style TargetType="TextBlock" x:Key="H"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,6"/></Style>
            <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,3"/></Style>
            <Style TargetType="TextBlock" x:Key="Hint"><Setter Property="Foreground" Value="Gray"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </StackPanel.Resources>

        <TextBlock Style="{StaticResource H}" Text="Sounds" Margin="0,0,0,6"/>
        <CheckBox Content="Mute all sounds" IsChecked="{Binding Muted}"/>
        <DockPanel Margin="0,4">
            <TextBlock Text="Volume" Width="110" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" AutomationProperties.Name="Volume"/>
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Text="Quiet hours" Width="110" VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding QuietFrom}" AutomationProperties.Name="Quiet hours from"/>
            <TextBlock Text=" to " VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding QuietTo}" AutomationProperties.Name="Quiet hours to"/>
            <TextBlock Text="  HH:mm, empty = off" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
        </DockPanel>
        <CheckBox Content="Stay silent when the source's window is already in front" IsChecked="{Binding SilentWhenFocused}"/>

        <TextBlock Style="{StaticResource H}" Text="Widget"/>
        <CheckBox Content="Hide while a fullscreen app, presentation or video is showing" IsChecked="{Binding HideWhenFullscreen}"/>
        <CheckBox Content="Float tiles that need you (Attention, Error) to the top" IsChecked="{Binding AutoSort}"/>
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows"/>

        <TextBlock Style="{StaticResource H}" Text="Claude Code"/>
        <DockPanel Margin="0,4">
            <TextBlock Text="Approval hold" Width="110" VerticalAlignment="Center"/>
            <TextBox Width="60" Text="{Binding HoldSeconds}" AutomationProperties.Name="Approval hold seconds"/>
            <TextBlock Text="  seconds (5–600). After that the terminal prompt takes over." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Margin="0,4">
            <TextBlock Text="Terminal launch" Width="110" VerticalAlignment="Center"/>
            <TextBox Text="{Binding TerminalTemplate}" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Terminal launch template"/>
        </DockPanel>
        <TextBlock Text="Used by Launch on a Claude tile. {cwd} and {cmd} are filled in." Style="{StaticResource Hint}" Margin="110,0,0,0"/>

        <TextBlock x:Name="Error" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
